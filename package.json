{
  "name": "@kwy404/graphemely",
  "version": "1.1.0",
  "description": "Count, slice and truncate JavaScript strings by visible character, so emoji, flags and accents never break.",
  "keywords": [
    "grapheme",
    "unicode",
    "emoji",
    "string",
    "truncate",
    "string-length",
    "intl-segmenter",
    "eslint-plugin"
  ],
  "author": "Alexandre Kohler (https://github.com/kwy404)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwy404/graphemely.git"
  },
  "homepage": "https://kwy404.github.io/graphemely/",
  "bugs": {
    "url": "https://github.com/kwy404/graphemely/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./eslint-plugin": {
      "import": {
        "types": "./dist/eslint-plugin.d.ts",
        "default": "./dist/eslint-plugin.js"
      },
      "require": {
        "types": "./dist/eslint-plugin.d.cts",
        "default": "./dist/eslint-plugin.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "eslint-plugin": [
        "./dist/eslint-plugin.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "size": "node scripts/size.mjs",
    "bench": "node scripts/bench.mjs",
    "docs:copy": "node scripts/copy-docs.mjs",
    "docs:build": "npm run build && node scripts/copy-docs.mjs && node scripts/build-docs.mjs && node scripts/highlight-docs.mjs",
    "prepublishOnly": "npm run build && npm run typecheck && npm test",
    "docs:highlight": "node scripts/highlight-docs.mjs"
  },
  "peerDependencies": {
    "eslint": ">=8.57.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "3.2.7",
    "esbuild": "0.27.7",
    "eslint": "9.39.5",
    "shiki": "3.23.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  }
}
